<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/slotContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- Circular Turn Badge -->
        <TextView
            android:id="@+id/turnNumber"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="1"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/text_light"
            android:gravity="center"
            android:background="@drawable/circular_badge"
            android:layout_marginEnd="16dp" />

        <!-- Event Icon -->
        <TextView
            android:id="@+id/eventIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="⚔️"
            android:textSize="32sp"
            android:gravity="center" />

        <!-- Event Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/eventName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enemy Attack"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_light" />

            <TextView
                android:id="@+id/eventSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Small raid. Deals 5 damage."
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Order Icon (if placed) -->
        <TextView
            android:id="@+id/orderIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="🛡️"
            android:textSize="24sp"
            android:gravity="center"
            android:visibility="gone" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
