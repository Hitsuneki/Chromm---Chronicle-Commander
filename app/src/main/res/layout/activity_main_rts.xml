<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark"
    tools:context=".MainActivity">

    <!-- Top Stats Bar -->
    <LinearLayout
        android:id="@+id/statsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/card_dark"
        android:elevation="4dp">

        <!-- Back Button -->
        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="20sp"
            android:textColor="@color/text_light"
            android:backgroundTint="@android:color/transparent"
            android:minWidth="48dp"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/hpLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❤️ HP"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/hpValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_light" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/suppliesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📦 Supplies"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/suppliesValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_light" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/intelLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧠 Intel"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/intelValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_light" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WAVE"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/waveValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_light" />
        </LinearLayout>

    </LinearLayout>

    <!-- Planning Timer -->
    <LinearLayout
        android:id="@+id/timerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@color/card_dark"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Planning Time:"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:paddingStart="8dp" />

        <ProgressBar
            android:id="@+id/timerProgress"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="2"
            style="?android:attr/progressBarStyleHorizontal"
            android:progressTint="@color/button_yellow" />

        <TextView
            android:id="@+id/timerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1:00"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_light"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <Button
            android:id="@+id/endButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="END"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#E53935"
            android:textColor="@color/text_light"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Swipeable Fronts Timeline -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@color/background_dark">

        <!-- Front Tabs -->
        <LinearLayout
            android:id="@+id/frontTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center">

            <TextView
                android:id="@+id/front1Tab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Front 1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_light"
                android:gravity="center"
                android:background="@color/card_dark"
                android:padding="8dp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/front2Tab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Front 2"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:background="@color/card_dark"
                android:padding="8dp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Horizontal Pager for two fronts -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/frontPagerRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            tools:listitem="@layout/item_front_page" />

        <!-- Optional Tooltip Panel -->
        <TextView
            android:id="@+id/tooltipText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:padding="8dp"
            android:background="@color/card_dark"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Commander Powers Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/card_dark"
        android:padding="8dp"
        android:gravity="center">

        <Button
            android:id="@+id/tacticalPauseButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="⏸️ Tactical Pause"
            android:textSize="12sp"
            android:backgroundTint="#2196F3"
            android:textColor="@color/text_light" />

        <Button
            android:id="@+id/airstrikeButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="✈️ Airstrike"
            android:textSize="12sp"
            android:backgroundTint="#E53935"
            android:textColor="@color/text_light" />
    </LinearLayout>

    <!-- Orders Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_dark"
        android:elevation="4dp"
        android:padding="12dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ordersRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            tools:listitem="@layout/item_order_card" />

        <!-- Resolve Button (hidden when timer is active) -->
        <Button
            android:id="@+id/resolveButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="Resolve Turn"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="@color/button_yellow"
            android:textColor="#000000"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>

